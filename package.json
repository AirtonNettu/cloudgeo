{
  "name": "cloudgeo",
  "version": "2.4.0",
  "description": "AWS Global Infrastructure Explorer — CloudGeo",
  "main": "app.js",
  "scripts": {
    "lint:js": "node --check app.js",
    "validate:catalogs": "node scripts/validate-catalogs.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:e2e": "playwright test",
    "test": "npm run lint:js && npm run validate:catalogs && npm run test:unit && npm run test:e2e",
    "verify:vendor": "node scripts/verify-vendor-integrity.js",
    "audit:data": "node scripts/audit-aws-data.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AirtonNettu/cloudgeo.git"
  },
  "author": "José Airton",
  "license": "MIT",
